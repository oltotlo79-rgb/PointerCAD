#!/bin/sh
# PointerCAD: 日本語の件名、接頭辞禁止、BOMなしUTF-8を施行する(rules/03 §6)。
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
validator="$hook_dir/../lib/commit_message.py"
if [ ! -f "$validator" ]; then
    printf '%s\n' '[NG] コミットコメントの検査処理が見つからないため中止します。' >&2
    exit 1
fi
if command -v python >/dev/null 2>&1; then
    exec python -B -X utf8 "$validator" "$1"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 -B -X utf8 "$validator" "$1"
fi
printf '%s\n' '[NG] Pythonが見つからないためコミットコメントを検査できません。' >&2
exit 127
