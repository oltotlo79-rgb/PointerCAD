# gitフックはshが読むので、Windowsでも必ずLFで取り出す。
# CRLFになると1行目の #!/bin/sh が壊れ、フックが動かないまま
# コミットやpushが通ってしまう(ORIGAMI3での実測に基づく先回り対策)。
scripts/hooks/pre-commit text eol=lf
scripts/hooks/pre-push text eol=lf
scripts/hooks/commit-msg text eol=lf

# CIの段の記録はlockfileの生バイト列を照合するため、両OSでLFに固定する。
# Windowsのcore.autocrlf=trueでも同じコミットのSHA-256を一致させる。
/pnpm-lock.yaml text eol=lf

# PowerShellスクリプトはBOM付きUTF-8を維持する(BOM無しだと
# Windows PowerShell 5.1 がANSIとして読み、日本語が化けて構文エラーになる。
# 2026-09-01 に本リポジトリで実測)。改行はCRLFのままでよい。
*.ps1 text

# 許諾原文は取得元と同じバイト列で検証・配布する。LF/CRLFが原文ごとに
# 異なるため、保存時も取り出し時もGitの改行変換を適用しない。
# 同梱フォント(Web/デスクトップ)の許諾原文(LICENSES.txt)も同じ方針の対象に含める。
docs/standards/licenses/*.txt -text
/vendor/opencascade/opencascade.js-b5ff984-closed-0839d9bcc8ac4677/LICENSE -text
apps/web/public/fonts/LICENSES.txt -text
apps/desktop/resources/fonts/LICENSES.txt -text
scripts/manual/fonts/*.txt -text

# アプリ自身の許諾本文も取得元のバイト列を保持する。
/LICENSE -text

# 同梱した計算部(opencascade.js)の一式は、取得元のバイトのまま導入され配布物へ入る。
# グルーコード dist/opencascade.full.js は導入後の実バイトの SHA-256(81cf6d92…)を
# packages/kernel/src/occt/invokerCompatibility.node.test.ts が照合する。core.autocrlf=true
# (Git for Windows・CI の windows-latest の既定)で取り出すと改行が CRLF になり SHA-256 が
# 3e448789… に変わる(2026-11-12、main の CI run 43038990339 で判明)。一式に改行変換を適用しない。
/vendor/opencascade/opencascade.js-b5ff984-closed-0839d9bcc8ac4677/** -text

# packages/ui/src/help/mathCatalogHelp.ts が生成する内容と、mathCatalogHelp.test.ts が
# バイト単位でtoBe比較する収録済みの章。core.autocrlf=true(Git for Windowsの既定)で取り出すと
# CRLFになり、生成側(LF)と一致しなくなる(2026-09-27、c3の全体検査で判明)。
# 常にLFで取り出すことで、Windows上の新規取り出し(CIのwindows-latest含む)でも一致させる。
packages/help-content/docs/ja/math-symbols.md text eol=lf
