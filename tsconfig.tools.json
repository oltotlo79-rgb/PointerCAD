{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/tools",
    "types": ["node"]
  },
  // TypeScript は include の結果が0件でも、files か references のどちらかが
  // 書かれていれば TS18003 を出さない。空の files を置くことで、対象の設定ファイルが
  // まだ1つも無い段階でも tsc --build が通り、かつ include はそのまま残るので
  // 後続タスクで *.config.ts / e2e/**/*.ts が増えたら自動で型検査に入る。
  "files": [],
  "references": [
    { "path": "./packages/test-utils" },
    { "path": "./packages/expression" },
    { "path": "./packages/model" },
    { "path": "./packages/io" }
  ],
  "include": [
    "*.config.ts",
    "packages/*/*.config.ts",
    "apps/*/*.config.ts",
    "apps/*/build/**/*.ts",
    "e2e/**/*.ts"
  ]
}
