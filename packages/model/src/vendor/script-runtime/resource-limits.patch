+/* PointerCAD: one VM per transaction; first resource fault survives guest catch.
+ * Capture only existing bytecode metadata, without allocating or running JS. */
+static int pointercad_resource_failure_code;
+static int pointercad_resource_line_number;
+static int pointercad_resource_column_number;
+static char pointercad_resource_source[129];
+__attribute__((export_name("pointercad_resource_failure")))
+int pointercad_resource_failure(void) { return pointercad_resource_failure_code; }
+__attribute__((export_name("pointercad_resource_line")))
+int pointercad_resource_line(void) { return pointercad_resource_line_number; }
+__attribute__((export_name("pointercad_resource_column")))
+int pointercad_resource_column(void) { return pointercad_resource_column_number; }
+__attribute__((export_name("pointercad_resource_file_byte")))
+int pointercad_resource_file_byte(int index) {
+    return index >= 0 && index < 129 ? (unsigned char)pointercad_resource_source[index] : 0;
+}
+static void pointercad_record_resource_failure(JSContext *ctx, int code) {
+    if (pointercad_resource_failure_code) return;
+    pointercad_resource_failure_code = code;
+    for (JSStackFrame *frame = ctx->rt->current_stack_frame; frame; frame = frame->prev_frame) {
+        if (JS_VALUE_GET_TAG(frame->cur_func) != JS_TAG_OBJECT || !frame->cur_pc) continue;
+        JSObject *object = JS_VALUE_GET_OBJ(frame->cur_func);
+        if (!js_class_has_bytecode(object->class_id)) continue;
+        JSFunctionBytecode *bytecode = object->u.func.function_bytecode;
+        if (!bytecode->filename || __JS_AtomIsTaggedInt(bytecode->filename)) continue;
+        JSAtomStruct *name = ctx->rt->atom_array[bytecode->filename];
+        if (!name || name->is_wide_char || name->len > 128) continue;
+        if (name->len >= 19 && !memcmp(str8(name), "pointercad-internal-", 19)) continue;
+        uint32_t pc = frame->cur_pc - bytecode->byte_code_buf - 1;
+        pointercad_resource_line_number = find_line_num(ctx, bytecode, pc, &pointercad_resource_column_number);
+        memcpy(pointercad_resource_source, str8(name), name->len);
+        pointercad_resource_source[name->len] = 0;
+        return;
+    }
+}
