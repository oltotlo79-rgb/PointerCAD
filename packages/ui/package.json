{
  "name": "@pointercad/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./security-policy": { "types": "./dist/security/contentSecurityPolicy.d.ts", "default": "./src/security/contentSecurityPolicy.ts" },
    "./print-settings": { "types": "./dist/file/drawingPrintSettings.d.ts", "default": "./src/file/drawingPrintSettings.ts" },
    "./save-errors": { "types": "./dist/file/saveFailure.d.ts", "default": "./src/file/saveFailure.ts" },
    "./open-with": { "types": "./dist/file/openWith.d.ts", "default": "./src/file/openWith.ts" },
    "./style.css": "./src/shell/appShell.css"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@pointercad/drawing": "workspace:*",
    "@pointercad/expression": "workspace:*",
    "@pointercad/help-content": "workspace:*",
    "@pointercad/io": "workspace:*",
    "@pointercad/model": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@pointercad/test-utils": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "vitest": "catalog:"
  }
}
