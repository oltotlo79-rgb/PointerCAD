# 依存とビルド成果物
node_modules/
dist/
# apps/* は Vite の成果物(dist/)と型の出力先(dist-types/)を分けている
dist-types/
out/
build/
# WebのCSP用ビルドプラグインは成果物ではなく入力ソース
!/apps/web/build/
/apps/web/build/*
!/apps/web/build/securityPolicy.ts
.vite/
coverage/
*.tsbuildinfo

# E2E
playwright-report/
test-results/

# 環境・エディタ
.env
.env.*
.DS_Store
Thumbs.db

# Claude Code ローカル設定(共有しない)
.claude/settings.local.json

# 一時作業
scratchpad/

# 目視の写真(担当が置く。追跡しない)
shots/

# Codex の sandbox 内で包み管理ツールが作る一時の store(追跡しない)
.pnpm-store/
