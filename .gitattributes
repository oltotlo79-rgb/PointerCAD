# gitフックはshが読むので、Windowsでも必ずLFで取り出す。
# CRLFになると1行目の #!/bin/sh が壊れ、フックが動かないまま
# コミットやpushが通ってしまう(ORIGAMI3での実測に基づく先回り対策)。
scripts/hooks/pre-commit text eol=lf
scripts/hooks/pre-push text eol=lf
scripts/hooks/commit-msg text eol=lf

# PowerShellスクリプトはBOM付きUTF-8を維持する(BOM無しだと
# Windows PowerShell 5.1 がANSIとして読み、日本語が化けて構文エラーになる。
# 2026-09-01 に本リポジトリで実測)。改行はCRLFのままでよい。
*.ps1 text

# 許諾原文は取得元と同じバイト列で検証・配布する。LF/CRLFが原文ごとに
# 異なるため、保存時も取り出し時もGitの改行変換を適用しない。
docs/standards/licenses/*.txt -text

# アプリ自身の許諾本文も取得元のバイト列を保持する。
/LICENSE -text
