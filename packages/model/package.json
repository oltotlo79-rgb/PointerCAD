{
  "name": "@pointercad/model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./desktop-occt-transport": {
      "types": "./dist/desktopOcctTransport.d.ts",
      "default": "./src/desktopOcctTransport.ts"
    },
    "./scripting": {
      "types": "./dist/scripting/index.d.ts",
      "default": "./src/scripting/index.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./beam-analysis": {
      "types": "./dist/analysis/index.d.ts",
      "default": "./src/analysis/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@pointercad/drawing": "workspace:*",
    "@pointercad/expression": "workspace:*",
    "@pointercad/kernel": "workspace:*",
    "comlink": "catalog:"
  },
  "devDependencies": {
    "@pointercad/test-utils": "workspace:*",
    "vitest": "catalog:"
  }
}
